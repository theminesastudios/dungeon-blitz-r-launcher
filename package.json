{
  "name": "dungeon-blitz-r-launcher",
  "version": "1.0.5",
  "private": true,
  "description": "Dungeon Blitz: R launcher with an embedded Adobe Flash (PPAPI) runtime",
  "homepage": "https://theminesa.studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theminesastudios/dungeon-blitz-r-launcher.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "extract-flash": "node tools/extract-flash.js",
    "test": "node tools/test-presence.js && node tools/test-chat-relay.js && node tools/test-social-bridge.js && node tools/test-discord-ipc.js && node tools/test-launcher-status.js && node tools/test-install-location.js && node tools/test-package-files.js && node tools/test-updater.js",
    "make-icons": "node tools/make-icons.js",
    "test-updater": "node tools/test-updater.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "predist:win": "node tools/preflight.js --platform win32",
    "predist:mac": "node tools/preflight.js --platform darwin",
    "predist:linux": "node tools/preflight.js --platform linux",
    "build:bridge": "cmake -S native_bridge -B native_bridge/build -DCMAKE_BUILD_TYPE=Release && cmake --build native_bridge/build --config Release"
  },
  "devDependencies": {
    "electron": "^11.5.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "4.3.9"
  },
  "author": "The Minesa Studios",
  "license": "MIT",
  "build": {
    "appId": "studio.theminesa.dungeonblitzr.launcher",
    "productName": "Dungeon Blitz R",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "theminesastudios",
        "repo": "dungeon-blitz-r-launcher"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "servers.json",
      "*.config.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "flash/${platform}/**/*",
          "social/${platform}/**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "DungeonBlitzR-Launcher-${version}-win-${arch}-setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "DungeonBlitzR-Launcher-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "The Minesa Studios <noreply@theminesa.studio>",
      "artifactName": "DungeonBlitzR-Launcher-${version}-linux-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DungeonBlitzR-Launcher-${version}-win-${arch}-portable.${ext}"
    }
  }
}
